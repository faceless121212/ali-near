# Only needed for NEAR testnet. `npm start` and `npm run demo` work without any of this.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
# A funded testnet account. `npm run deploy:testnet` and `npm run deploy:hub` create everything else under it.
# Not needed to run the app: wallet mode reads the public testnet.json.
OWNER_ACCOUNT_ID=your-name.testnet
OWNER_PRIVATE_KEY=ed25519:...

# Filled in by `npm run deploy:testnet`:
# LEDGER=near
# VAULT_ACCOUNT_ID=budget.your-name.testnet
# AGENT_PRIVATE_KEY=ed25519:...   (the vault's pay-only function-call key)
# ASSET_CONTRACT_ID=usdc.your-name.testnet
# MARKET_ROOT=your-name.testnet

# For the older two-process example (npm run server / npm run agent)
# PAY_TO_ACCOUNT_ID=weather-api.your-name.testnet
# PORT=4021
