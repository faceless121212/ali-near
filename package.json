{
  "name": "ali",
  "version": "0.1.0",
  "description": "Ali: pay-per-call APIs for AI agents on NEAR (Near6 protocol), guarded by an on-chain Agent Firewall",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "tsx src/app/main.ts",
    "demo": "tsx src/demo.ts",
    "server": "tsx src/examples/server.ts",
    "agent": "tsx src/examples/agent.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:contracts": "sh scripts/build-contracts.sh",
    "deploy:testnet": "tsx scripts/deploy-testnet.ts"
  },
  "dependencies": {
    "express": "^4.22.3",
    "near-api-js": "^5.1.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
